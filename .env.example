# Copia in .env e compila SOLO in locale. Mai in chat, mai su GitHub.

# Posta (Fase 4) — OAuth a permessi minimi: sola lettura + bozze
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
IMAP_HOST=
IMAP_USER=info@gasparepettinati.it
IMAP_PASSWORD=          # preferire password per app, non quella principale

# GitHub (Fase 1) — usare `gh auth login` invece del token quando possibile
GITHUB_USER=

# Calendario (Fase 6)
GOOGLE_CALENDAR_ID=
